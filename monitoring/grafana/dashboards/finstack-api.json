{
  "title": "FinStack API Observability",
  "uid": "finstack-api-obs",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "API Target Status (Up = 1)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"finstack-api\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Total HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(http_requests_total)", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(http_requests_total[1m])", "legendFormat": "{{method}} {{handler}} ({{status}})", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Request Latency (p95 seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))", "legendFormat": "{{handler}}", "refId": "A" }
      ]
    }
  ]
}
